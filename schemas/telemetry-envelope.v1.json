{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MDriveTelemetryEnvelope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "sequenceNumber": {
      "type": "integer",
      "minimum": 0
    },
    "monotonicTimestamp": {
      "type": "integer"
    },
    "wallClockTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "messageType": {
      "type": "string",
      "enum": ["LOG", "METRIC", "HTTP_TRANSACTION", "LIFECYCLE"]
    },
    "payload": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "payload": {
          "type": ["object", "null"]
        },
        "stack": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "level",
        "category",
        "event",
        "message"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "deviceId",
    "sequenceNumber",
    "monotonicTimestamp",
    "wallClockTimestamp",
    "messageType",
    "payload"
  ]
}
